# ==========================================
# PrepPath Environment Variables Example
# Copy to .env and configure for your environment
# NEVER commit real credentials or secrets to git!
# ==========================================

# Database
DB_PASSWORD=your_db_password_here

# Google OAuth (Web Application Client ID, no secret used)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# JWT Configuration (Secret must be at least 32 characters / 256 bits)
JWT_SECRET=your_jwt_signing_secret_min_32_characters_long_here

# Refresh Cookie Security (set to true in production, false for non-https localhost dev)
REFRESH_COOKIE_SECURE=false

# Access & Domain Authorization
ADMIN_EMAILS=admin@nie.edu.in
ALLOWED_EMAIL_DOMAINS=nie.edu.in
ALLOW_ANY_GOOGLE_ACCOUNT=false
DEV_LOGIN_ENABLED=false

# CORS & Networking
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin API Key (leave empty in production to enforce ROLE_ADMIN JWT only)
ADMIN_API_KEY=
